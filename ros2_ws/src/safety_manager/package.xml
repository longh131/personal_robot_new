<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/XMLSchema"?>
<package format="3">
  <name>safety_manager</name>
  <version>0.1.0</version>
  <description>Mode mutex, estop latch, timeout. Publishes /cmd_vel_safe only. Does not open C30D serial.</description>
  <maintainer email="andylong@todo.todo">andylong</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>c30d_driver</exec_depend>
  <exec_depend>command_bus</exec_depend>
  <exec_depend>lidar_pkg</exec_depend>
  <exec_depend>lidar_assist</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
